# ============================================================
# MoA Swarm Architecture - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# ─── API Keys ────────────────────────────────────────────────
# OpenAI API Key (for GPT-4, GPT-3.5)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude 3)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GLM (Zhipu) API Key (for GLM-4.7-flash)
GLM_API_KEY=your_glm_api_key_here

# Browserbase API Key (for stealth browser sessions)
BROWSERBASE_API_KEY=your_browserbase_api_key_here

# ─── Model Endpoints ────────────────────────────────────────
# Default model endpoint (OpenAI-compatible)
DEFAULT_MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions

# GLM endpoint (Zhipu AI)
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Claude endpoint (Anthropic)
CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages

# ─── VPS Configuration ──────────────────────────────────────
# VPS IP address (for remote deployment)
VPS_IP=your_vps_ip_here

# SSH key path (for remote deployment)
VPS_SSH_KEY=~/.ssh/id_rsa

# ─── Docker Configuration ───────────────────────────────────
# Docker registry (for custom images)
DOCKER_REGISTRY=your_registry_here

# Docker network name
DOCKER_NETWORK=moa-swarm-net

# Docker image prefix
DOCKER_IMAGE_PREFIX=moa-swarm

# ─── Swarm Configuration ────────────────────────────────────
# Number of concurrent agents in the pool
AGENT_POOL_SIZE=5

# Task timeout in seconds
TASK_TIMEOUT=60

# Number of retry attempts for failed tasks
RETRY_ATTEMPTS=3

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=30

# Maximum concurrent MoA proposer calls
MAX_CONCURRENT_PROPOSERS=10

# ─── Browser Configuration ──────────────────────────────────
# Browser type (chromium, firefox, webkit)
BROWSER_TYPE=chromium

# Headless mode (true/false)
BROWSER_HEADLESS=true

# Browser viewport width
BROWSER_VIEWPORT_WIDTH=1280

# Browser viewport height
BROWSER_VIEWPORT_HEIGHT=720

# ─── Logging Configuration ──────────────────────────────────
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/swarm.log

# Log format (json, text)
LOG_FORMAT=json

# ─── Token Optimization ─────────────────────────────────────
# Enable ztk compression (true/false)
ENABLE_ZTK_COMPRESSION=true

# ztk compression level (1-9, higher = more compression)
ZTK_COMPRESSION_LEVEL=5

# ─── Security Configuration ─────────────────────────────────
# Enable API key rotation (true/false)
ENABLE_KEY_ROTATION=false

# Key rotation interval in hours
KEY_ROTATION_INTERVAL=24

# Enable request signing (true/false)
ENABLE_REQUEST_SIGNING=false

# ─── Monitoring Configuration ───────────────────────────────
# Enable Prometheus metrics (true/false)
ENABLE_PROMETHEUS=true

# Prometheus port
PROMETHEUS_PORT=9090

# Enable distributed tracing (true/false)
ENABLE_TRACING=true

# Tracing endpoint (Jaeger, Zipkin, etc.)
TRACING_ENDPOINT=http://localhost:14268/api/traces
